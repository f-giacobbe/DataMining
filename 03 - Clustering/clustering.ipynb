     "output_type": "execute_result"
    }
   ],
   "source": [
    "from sklearn.metrics import silhouette_score\n",
    "silhouette_score(X, kmeans.labels_)         # UNICO COMANDO CHE SERVE ALL'ESAME"
   ]
